{
  "name": "socilab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "turbo watch dev --filter=@socilab/server --filter=@socilab/client --filter=@socilab/admin",
    "dev:server": "turbo watch dev --filter=@socilab/server",
    "dev:client": "turbo watch dev --filter=@socilab/client",
    "dev:admin": "turbo watch dev --filter=@socilab/admin",
    "build": "turbo run build",
    "lint": "eslint --cache .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --passWithNoTests",
    "test:linter": "vitest run tests/linter --passWithNoTests",
    "spellcheck": "cspell lint --config cspell.config.mjs --gitignore --no-progress \"**/*.{cjs,js,json,jsonc,jsx,md,mjs,ts,tsx,yaml,yml}\"",
    "start": "pnpm --filter @socilab/server start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@babel/core": "8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@hono/node-server": "^2.0.12",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.139.16",
    "@tanstack/router-plugin": "^1.139.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "^2.1.1",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "hono": "^4.12.32",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": "eslint --cache --fix"
  }
}
