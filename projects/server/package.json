{
  "name": "@socilab/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/projects/server/src/index.d.ts",
      "default": "./dist/projects/server/src/index.js"
    }
  },
  "types": "./dist/projects/server/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/app/server.ts",
    "start": "node --env-file-if-exists=.env dist/projects/server/src/app/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --root ../.. run tests/server"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@orpc/openapi": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@socilab/api": "workspace:*",
    "hono": "^4.12.32",
    "zod": "4.4.3"
  }
}
