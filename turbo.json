{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.json",
    "eslint.config.mjs",
    "vitest.config.ts"
  ],
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@socilab/admin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@socilab/client#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@socilab/server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "//#lint:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/**",
        "projects/**",
        "tests/**",
        "!packages/**/dist/**",
        "!projects/**/dist/**"
      ],
      "outputs": [".eslintcache"]
    },
    "//#typecheck:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/**",
        "projects/**",
        "tests/**",
        "!packages/**/dist/**",
        "!projects/**/dist/**"
      ]
    },
    "//#test:linter:repo": {
      "cache": false
    },
    "//#test:repo": {
      "cache": false
    }
  }
}
